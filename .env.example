# =============================================================================
# Papermark environment configuration
#
# The defaults below are wired to the local containers in docker-compose.yml,
# so `docker compose up -d && cp .env.example .env` gives you a working
# database and blob store with no third-party accounts.
#
# Full walkthrough: docs/self-hosting.md
# =============================================================================

# [[APP]]
NEXTAUTH_SECRET=my-superstrong-secret
NEXTAUTH_URL=http://localhost:3000

NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_MARKETING_URL=http://localhost:3000

NEXT_PUBLIC_APP_BASE_HOST=localhost

# Shared secret for Papermark's server-to-server API calls (presigned URLs,
# notification callbacks). Any long random string works — `openssl rand -hex 32`.
INTERNAL_API_KEY=my-superstrong-internal-api-key

# Encryption key for document passwords.
NEXT_PRIVATE_DOCUMENT_PASSWORD_KEY=my-superstrong-document-secret

# =============================================================================
# [[DATABASE]] — provided by the `postgres` service in docker-compose.yml
#
# Papermark runs on any PostgreSQL 14+ instance. The two URLs exist because
# Prisma expects a pooled connection and a direct one; against a plain
# Postgres server they are simply the same URL.
#
# To use a hosted database (Neon, Supabase, RDS, …) instead, replace both
# values with that provider's pooled and direct connection strings.
# =============================================================================
POSTGRES_PRISMA_URL="postgresql://papermark:papermark@localhost:5432/papermark?schema=public"
POSTGRES_PRISMA_URL_NON_POOLING="postgresql://papermark:papermark@localhost:5432/papermark?schema=public"
# Only needed for `npx prisma migrate dev` when authoring new migrations.
# The docker-compose Postgres creates this database for you on first boot.
POSTGRES_PRISMA_SHADOW_URL="postgresql://papermark:papermark@localhost:5432/papermark_shadow?schema=public"

# =============================================================================
# [[STORAGE]] — provided by the `minio` service in docker-compose.yml
#
# Document content lives in S3-compatible object storage. MinIO speaks the S3
# API, so the same settings work for AWS S3, Cloudflare R2, Backblaze B2,
# Hetzner, Wasabi, or the local container.
# =============================================================================

# Storage transport. Document uploads require "s3"; "vercel" remains only for
# reading documents stored before the S3 migration.
NEXT_PUBLIC_UPLOAD_TRANSPORT="s3"

# S3 API endpoint. Leave empty to talk to real AWS S3.
NEXT_PRIVATE_UPLOAD_ENDPOINT="http://localhost:9000"

# Address buckets as <endpoint>/<bucket>/<key> instead of <bucket>.<endpoint>.
# Set to "true" for MinIO and most other S3-compatible servers; leave empty
# (or "false") for AWS S3.
NEXT_PRIVATE_UPLOAD_FORCE_PATH_STYLE="true"

# Region. MinIO ignores it but the AWS SDK requires a value.
NEXT_PRIVATE_UPLOAD_REGION="us-east-1"

# Buckets. All three are created automatically by the minio-init container.
NEXT_PRIVATE_UPLOAD_BUCKET="papermark-documents"
NEXT_PRIVATE_ARCHIVE_BUCKET="papermark-archive"

# Bucket for public assets: brand logos, banners, link preview images.
# Setting it stores those in S3 instead of Vercel Blob; they are served through
# this app at /api/assets, so the bucket itself stays private.
# Leave EMPTY to keep using Vercel Blob (requires BLOB_READ_WRITE_TOKEN).
NEXT_PRIVATE_PUBLIC_BUCKET="papermark-public"

# Credentials. These match MINIO_ROOT_USER / MINIO_ROOT_PASSWORD in
# docker-compose.yml. Change both together, and change them before exposing
# MinIO beyond localhost.
NEXT_PRIVATE_UPLOAD_ACCESS_KEY_ID="papermark"
NEXT_PRIVATE_UPLOAD_SECRET_ACCESS_KEY="papermark-secret"

# --- CDN (CloudFront) --------------------------------------------------------
# Leave ALL of these empty when serving files straight from S3/MinIO. Setting
# a distribution host switches Papermark to CloudFront-signed URLs, which the
# local MinIO container cannot satisfy.
#
# Host (no protocol) of the CDN or bucket that serves files. Also added to the
# next/image allow-list in next.config.mjs.
NEXT_PRIVATE_UPLOAD_DISTRIBUTION_HOST=""
# Public key ID used to sign CloudFront URLs.
NEXT_PRIVATE_UPLOAD_DISTRIBUTION_KEY_ID=""
# PEM-encoded RSA 2048 private key used to sign CloudFront URLs.
NEXT_PRIVATE_UPLOAD_DISTRIBUTION_KEY_CONTENTS=

# =============================================================================
# [[REDIS]] — provided by the `redis` + `redis-http` services in
# docker-compose.yml
#
# Papermark uses the Upstash REST client, so it needs an HTTP endpoint rather
# than a redis:// URL. The `redis-http` container speaks that protocol on top
# of a plain Redis, which is why the URLs below are http:// and not redis://.
#
# Backs sign-in codes, rate limiting, and the tus.io upload lock. Sign-in
# does not work without it.
#
# To use Upstash instead, paste their REST URL and token into all four values.
# =============================================================================
UPSTASH_REDIS_REST_URL="http://localhost:8079"
UPSTASH_REDIS_REST_TOKEN="papermark-redis-token"

# Distributed lock for tus.io bulk uploads. Can point at the same instance.
UPSTASH_REDIS_REST_LOCKER_URL="http://localhost:8079"
UPSTASH_REDIS_REST_LOCKER_TOKEN="papermark-redis-token"

# =============================================================================
# [[EXTERNAL SERVICES]]
#
# Papermark boots without these. Each one disables a specific feature when
# left blank — see docs/self-hosting.md for the breakdown.
# =============================================================================

# Vercel Blob — only needed when NEXT_PRIVATE_PUBLIC_BUCKET is left empty, plus
# for exported visit reports and link bulk-import files. With the public bucket
# configured above, brand assets no longer touch Vercel Blob.
BLOB_READ_WRITE_TOKEN=

# Google OAuth — optional sign-in provider. Email sign-in works without it.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend — transactional email. REQUIRED for email sign-in: Papermark mails a
# login code and has no console fallback. Skip it only if you sign in with
# Google OAuth instead.
RESEND_API_KEY=

# Sender address for all outgoing mail. Papermark's defaults are @papermark.com
# addresses, which Resend rejects unless your account has verified that domain,
# so self-hosted instances must set this to a domain they own.
RESEND_FROM_EMAIL="Papermark <noreply@yourdomain.com>"

# In development Papermark routes mail to Resend's sink (delivered@resend.dev)
# so local runs cannot email real people. Set to "true" when you are
# deliberately testing delivery to your own address.
RESEND_DELIVER_IN_DEV=

# Tinybird — view/visit analytics. Without it, documents still work but
# analytics pages stay empty.
TINYBIRD_TOKEN=

# Vercel — only for provisioning customer custom domains.
PROJECT_ID_VERCEL=
TEAM_ID_VERCEL=
AUTH_BEARER_TOKEN=

# Upstash QStash — queues and background jobs.
# https://upstash.com/docs/qstash/overall/getstarted
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Hanko — passkey signup. lib/hanko.ts throws at import time if these are
# empty, which takes the auth routes down with it, so keep the placeholders
# even when you do not use passkeys.
# https://docs.hanko.io/passkey-api/reference/credentials/list-credentials
HANKO_API_KEY=add-your-hanko-api-key
NEXT_PUBLIC_HANKO_TENANT_ID=add-your-hanko-tenant-id

# Trigger.dev — document processing pipeline (PDF to image conversion,
# bulk downloads, notification fan-out).
TRIGGER_SECRET_KEY=
TRIGGER_API_URL=https://api.trigger.dev

# [[VERIFICATION]]
# Secret used to generate the checksum for the verification URL
NEXT_PRIVATE_VERIFICATION_SECRET=

# [[INCOMING WEBHOOKS]]
NEXT_PUBLIC_WEBHOOK_BASE_URL=
NEXT_PUBLIC_WEBHOOK_BASE_HOST=

# Stripe — billing. The SDK is constructed at import time and rejects an empty
# key, which 500s the auth routes, so a placeholder is required even when you
# never touch billing. Replace with a real key only if you enable payments.
STRIPE_SECRET_KEY="sk_test_placeholder"
STRIPE_SECRET_KEY_OLD="sk_test_placeholder"
